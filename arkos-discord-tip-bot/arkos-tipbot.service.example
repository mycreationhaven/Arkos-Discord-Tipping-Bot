[Unit]
Description=ARKOS Discord Tip Bot
After=network-online.target

[Service]
Type=simple
User=arkostipbot
Group=arkostipbot
WorkingDirectory=/opt/arkos-tipbot
EnvironmentFile=/etc/arkos-tipbot.env
ExecStart=/usr/bin/node /opt/arkos-tipbot/src/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/arkos-tipbot

[Install]
WantedBy=multi-user.target
