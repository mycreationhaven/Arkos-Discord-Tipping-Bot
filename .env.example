# Discord
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_GUILD_ID=your_discord_server_id

# Arkovia node
ARKOVIA_NODE_URL=http://127.0.0.1:4876/nxt

# ARKOS bot wallet
ARKOS_HOT_WALLET_ACCOUNT=ARK-XXXX-XXXX-XXXX-XXXXX
ARKOS_HOT_WALLET_SECRET_PHRASE=your_bot_hot_wallet_secret_phrase
ARKOS_FAUCET_ACCOUNT=ARK-XXXX-XXXX-XXXX-XXXXX

# Discord ledger settings
STARTING_BALANCE_ARKOS=10
TIP_UNIT_NQT=100000
WITHDRAW_MIN_ARKOS=2
WITHDRAW_FEE_ARKOS=1
DAILY_TIP_LIMIT_ARKOS=2
MAX_SINGLE_TIP_UNITS=100

# Deposit scanner
DEPOSIT_MIN_ARKOS=5
DEPOSIT_REQUIRED_CONFIRMATIONS=3
DEPOSIT_SCAN_INTERVAL_SECONDS=30

# Public activity API
ACTIVITY_API_HOST=127.0.0.1
ACTIVITY_API_PORT=4880
ARKOS_DISCORD_API_TOKEN=generate_a_long_random_token

# Optional comma-separated Discord admin user IDs
ADMIN_DISCORD_IDS=
